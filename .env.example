# The browser calls only Torob Match's same-origin endpoint. Never use a VITE_ variable for API keys.
VITE_INTENT_ENHANCER_ENABLED=false
VITE_INTENT_ENHANCER_ENDPOINT=/api/intent/enhance
VITE_INTENT_ENHANCER_TIMEOUT_MS=15000

# Optional OpenAI-compatible server configuration (OpenAI, Ollama, LM Studio, or another compatible provider).
TOROB_MATCH_INTENT_LLM_ENABLED=false
TOROB_MATCH_INTENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
TOROB_MATCH_INTENT_LLM_MODEL=gpt-6-luna
TOROB_MATCH_INTENT_LLM_API_KEY=
TOROB_MATCH_INTENT_LLM_FORMAT=json_schema
TOROB_MATCH_INTENT_LLM_TIMEOUT_MS=12000
TOROB_MATCH_INTENT_LLM_REASONING_EFFORT=none
# Leave empty for automatic selection: max_completion_tokens for OpenAI, max_tokens for local providers.
TOROB_MATCH_INTENT_LLM_MAX_TOKENS_PARAMETER=

# In-memory privacy-preserving cache and abuse controls.
TOROB_MATCH_INTENT_CACHE_TTL_MS=86400000
TOROB_MATCH_INTENT_CACHE_MAX_ENTRIES=500
TOROB_MATCH_INTENT_RATE_LIMIT=10
TOROB_MATCH_INTENT_RATE_WINDOW_MS=60000
TOROB_MATCH_INTENT_MAX_CONCURRENT=2
TOROB_MATCH_INTENT_MAX_QUEUE=20

# Development metrics contain counts, latency, tokens, and estimated cost; never raw search text.
TOROB_MATCH_INTENT_METRICS_ENABLED=true
TOROB_MATCH_INTENT_INPUT_USD_PER_MILLION=0.10
TOROB_MATCH_INTENT_CACHED_USD_PER_MILLION=0.01
TOROB_MATCH_INTENT_OUTPUT_USD_PER_MILLION=0.50

# Production-like local server. Change if the port is already in use.
PORT=4174
